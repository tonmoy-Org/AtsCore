# AtsCore Enterprise Configuration

# Server
PORT=8000
HOST=0.0.0.0
FLASK_ENV=production
SECRET_KEY=ats_enterprise_secret_key_secure_2026

# PostgreSQL (Main Database)
# Note: When connecting to Docker PostgreSQL from host machine, port is 5433
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=ats_recovery_db
PG_USER=postgres
PG_PASSWORD=ats_enterprise_pg_pass_2026
PG_POOL_MIN=4
PG_POOL_MAX=32

# DragonflyDB (L1 Cache & Telecom Queue Engine)
# Note: When connecting to Docker DragonflyDB from host machine, port is 6380
DRAGONFLY_HOST=127.0.0.1
DRAGONFLY_PORT=6380
DRAGONFLY_DB=0
DRAGONFLY_POOL_DB=1

# SQLite Source Data (for migration)
SQLITE_SOURCE_PATH=E:\master_sheet\Fast_Excel_Sheet.db
