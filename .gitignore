# ==============================================================================
# AtsCore Git Ignore Rules
# ==============================================================================

# 1. Environment & Secret Configuration
.env
.env.*
.env.local
!.env.example

# 2. Python Bytecode, Caches & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# 4. Database Files & Backups
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.dump
*.sql
*.sql.gz
*.backup

# 5. Application Logs & Crash Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid

# 6. Temporary & Data Exports
exports/
temp/
tmp/
*.csv
*.tsv
*.xlsx
*.parquet

# 7. IDE, Editor & Tool Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 8. Testing, Linting & Coverage
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/
.tox/
.nox/

# 9. Docker Volumes & Local Run State
.docker/
docker-compose.override.yml

# 10. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

